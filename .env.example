# Smart Agri-Partner Environment Configuration

# Demo Mode toggle: true uses local resilient datasets, false calls live APIs
DEMO_MODE=true

# External API Keys (Optional - demo fallbacks activate automatically if empty)
WEATHER_API_KEY=
MANDI_API_KEY=
LLM_API_KEY=

# Localization & Preferences
DEFAULT_LANGUAGE=en
DATABASE_URL=sqlite:///smart_agri_partner.db
LOG_LEVEL=INFO

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
